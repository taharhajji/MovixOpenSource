{
  "name": "mewflix-desktop",
  "productName": "MEWFLIX",
  "version": "1.0.0",
  "description": "Application de bureau Windows (Electron) : lecteur de streaming connecté aux serveurs du service, extension intégrée, blocage des pubs en phase de test.",
  "author": "MEWFLIX",
  "license": "CC-BY-NC-4.0",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/movixstream/MovixOpenSource",
  "repository": {
    "type": "git",
    "url": "https://github.com/movixstream/MovixOpenSource.git"
  },
  "scripts": {
    "sync:userscript": "node scripts/sync-userscript.mjs",
    "prestart": "node scripts/sync-userscript.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "node scripts/sync-userscript.mjs",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "release:manifest": "node scripts/release-manifest.mjs",
    "test": "node --test",
    "icon": "electron scripts/render-icon.js",
    "build:mac": "electron-builder --mac",
    "build:mac:dir": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.mewflix.player",
    "productName": "MEWFLIX",
    "copyright": "CC BY-NC 4.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MEWFLIX",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "language": "1036"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/movixstream/MovixOpenSource/main/desktop/release",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
